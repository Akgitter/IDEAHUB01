# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/ideahub
# For production (MongoDB Atlas):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ideahub?retryWrites=true&w=majority

# JWT Secret (change this to a secure random string in production)
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# JWT Expiration
JWT_EXPIRES_IN=7d

# Allowed Email Domain
ALLOWED_EMAIL_DOMAIN=dtu.ac.in

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email Configuration (for email verification)
# Option 1: Using Gmail (for development)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password
EMAIL_FROM=IdeaHub <noreply@ideahub.com>

# Option 2: Using SendGrid (recommended for production)
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USER=apikey
# EMAIL_PASSWORD=your_sendgrid_api_key
# EMAIL_FROM=IdeaHub <noreply@ideahub.com>

# Email Verification
EMAIL_VERIFICATION_EXPIRY_HOURS=24

